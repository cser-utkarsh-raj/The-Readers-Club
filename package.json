{
  "name": "the-readers-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "tsx backend/src/server.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node server.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test frontend/src/utils/bookLogic.test.ts backend/src/server.test.ts tests/fidelity/textRank.test.ts tests/fidelity/storyMemory.test.ts",
    "test:e2e": "tsx scripts/e2e-verify.ts",
    "validate:catalog": "tsx scripts/validate-catalog.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}

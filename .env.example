# GEMINI_API_KEY: Required for Gemini AI Summarization and Text-to-Speech API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_SUMMARIZE_MODEL: Configurable Gemini model for chapter summarization (defaults to gemini-3.8-flash)
GEMINI_SUMMARIZE_MODEL="gemini-3.8-flash"

# GEMINI_TTS_MODEL: Configurable Gemini model for long-form audiobook TTS (defaults to gemini-3.8-flash-lite-tts)
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
